__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
scores.csv
scores_*.csv
data/processed/scores_*.csv

# Große Roh-/Cachedaten — nicht committen (siehe README / Zenodo):
data/raw/*
!data/raw/.gitkeep
!data/raw/aaer_mark5.csv
!data/raw/financials_panel.csv
!data/raw/edgar_8k_events.csv
